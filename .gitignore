.ruff_cache/

# --- Virtualenv ---
venv/
.venv/
env/

# --- Model weights (too large for git) ---
weights/*.pt
weights/*.pl
weights/*.pth
weights/*.bin
weights/*.safetensors

# --- Runtime data ---
storage/uploads/*
storage/results/*
