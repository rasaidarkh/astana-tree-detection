!storage/results/.gitkeep

# --- Datasets ---
data/raw/*
data/annotated/*
data/processed/*
!data/raw/.gitkeep
!data/annotated/.gitkeep
!data/processed/.gitkeep

# --- YOLO training artifacts ---
# Track Ultralytics-generated visualisations (results, curves, val_batch_pred,
# train_batch, confusion matrices ~ 18 MB total) so teammates can inspect them
# without re-running training. The model weight checkpoints (~ 137 MB each, six
# total) live under runs/segment/*/weights/ and are excluded — the production
# v2-finetune weights are published as the `weights-v2-finetune` GitHub release.
runs/**/weights/
# Pretrained weights downloaded by Ultralytics at repo root (re-fetched on demand)
/yolo*.pt
# Derived YOLO datasets (regenerated by ml/coco_to_yolo_seg.py + ml/tile_dataset.py)
yolov train dataset/yolo/
yolov train dataset/yolo_tiled/
yolov train dataset/prelabel/

# --- IDE ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- OS ---
*.log
.cache/

# --- Notebooks ---
.ipynb_checkpoints/

