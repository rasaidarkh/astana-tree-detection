thesis/latex/*.synctex.gz
# thesis/latex/figures/ is a mirror of thesis/figures/ created by build_latex.py
# at compile time; the source-of-truth is thesis/figures/, so the mirror is ignored.
thesis/latex/figures/
_extract.py
"критериии и примеры"/

# --- ML training logs (PyTorch Lightning auto-creates these) ---
lightning_logs/

# --- Local weights backups ---
weights/*.bak

# --- Derived val-only datasets (regenerated from annotations/) ---
yolov train dataset/yolo_v1_val_only/
yolov train dataset/yolo_v1_val_only_tiled/

# --- Pre-label outputs (regenerated by ml/prelabel_coco.py) ---
yolov train dataset/prelabel*.json

# --- Claude Code session data ---
.claude/

# --- Ad-hoc folders for testing ---
"Новая папка/"

# --- SQLite persistence store (local state, varies per machine) ---
storage/app.db
storage/app.db-shm
storage/app.db-wal

# --- Working unified photos folder is regenerated by copy from новые фотографии/ ---
